# Copy to apps/api/.env (the dev setup does this for you). Not needed in mock mode.

# 1 = no AWS at all: local files + sample extraction + emails saved to apps/api/.data/outbox
MOCK_AWS=1

# --- AWS mode (set MOCK_AWS=0). Deployed Lambdas get these from CDK automatically. ---
AWS_REGION=ap-south-1
TABLE_NAME=
UPLOAD_BUCKET=
# Verified SES sender (identity). Without it, email sending fails with a clear message.
SES_FROM=

# --- Optional ---
APP_URL=http://localhost:5173
ALLOWED_ORIGIN=*
CASE_TTL_DAYS=30
MAX_EMAILS_PER_CASE=10
MAX_RFQ_PER_CASE=5
PVGIS_BASE=https://re.jrc.ec.europa.eu/api/v5_2
LOG_LEVEL=INFO
DATA_DIR=.data
